// Unit tests for rounding modes and checked / rounding-aware operations.
// Expected values were computed with Python exact rationals.
use core::fixed::{Fixed, Ray, SWad, UFixed, Wad}
use ingot::{Down, FixedOps, Nearest, Up, Zero, checked_rescale, checked_rescale_signed, mul_div_r, signed_mul_div_r}

const MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
const I_MAX: i256 = 0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

fn wad(_ raw: u256) -> Wad { Wad::from_raw(raw) }
fn swad(_ raw: i256) -> SWad { SWad::from_raw(raw) }

#[test]
fn integer_mul_div_rounding() {
    // 7 * 1 / 2 = 3.5
    assert!(mul_div_r<Down>(7, 1, 2).unwrap() == 3)
    assert!(mul_div_r<Zero>(7, 1, 2).unwrap() == 3)
    assert!(mul_div_r<Up>(7, 1, 2).unwrap() == 4)
    assert!(mul_div_r<Nearest>(7, 1, 2).unwrap() == 4)
    // 10 / 3 = 3.33.. and 11 / 3 = 3.66..
    assert!(mul_div_r<Nearest>(10, 1, 3).unwrap() == 3)
    assert!(mul_div_r<Nearest>(11, 1, 3).unwrap() == 4)
    // exact results never move
    assert!(mul_div_r<Up>(6, 1, 3).unwrap() == 2)
    assert!(mul_div_r<Nearest>(6, 1, 3).unwrap() == 2)
    // 512-bit intermediate
    assert!(mul_div_r<Up>(MAX, MAX, MAX).unwrap() == MAX)
    // overflow and division by zero give None
    assert!(mul_div_r<Down>(MAX, 2, 1).is_none())
    assert!(mul_div_r<Down>(1, 1, 0).is_none())
    // rounding up past u256::max is an overflow
    assert!(mul_div_r<Up>(MAX, 3, 2).is_none())
    assert!(mul_div_r<Down>(MAX, 2, 2).unwrap() == MAX)
}

#[test]
fn signed_rounding_directions() {
    // -7 / 2 = -3.5
    assert!(signed_mul_div_r<Down>(-7, 1, 2).unwrap() == -4)
    assert!(signed_mul_div_r<Up>(-7, 1, 2).unwrap() == -3)
    assert!(signed_mul_div_r<Zero>(-7, 1, 2).unwrap() == -3)
    assert!(signed_mul_div_r<Nearest>(-7, 1, 2).unwrap() == -4)
    // -10 / 3 = -3.33..
    assert!(signed_mul_div_r<Down>(-10, 1, 3).unwrap() == -4)
    assert!(signed_mul_div_r<Up>(-10, 1, 3).unwrap() == -3)
    assert!(signed_mul_div_r<Nearest>(-10, 1, 3).unwrap() == -3)
    // sign from any operand
    assert!(signed_mul_div_r<Down>(7, -1, 2).unwrap() == -4)
    assert!(signed_mul_div_r<Down>(7, 1, -2).unwrap() == -4)
    assert!(signed_mul_div_r<Down>(-7, -1, 2).unwrap() == 3)
    // tiny negative values: floor goes to -1, ceil and trunc to 0
    assert!(signed_mul_div_r<Down>(-1, 1, 3).unwrap() == -1)
    assert!(signed_mul_div_r<Up>(-1, 1, 3).unwrap() == 0)
    assert!(signed_mul_div_r<Zero>(-1, 1, 3).unwrap() == 0)
    // i256::MIN is representable, -i256::MIN is not
    let min = -I_MAX - 1
    assert!(signed_mul_div_r<Down>(min, 1, 1).unwrap() == min)
    assert!(signed_mul_div_r<Down>(min, -1, 1).is_none())
    assert!(signed_mul_div_r<Down>(1, 1, 0).is_none())
}

#[test]
fn unsigned_fixed_rounding() {
    let third = Wad::from_ratio(1, 3)
    assert!(third.mul_r<Down>(third) == wad(111111111111111110))
    assert!(third.mul_r<Up>(third) == wad(111111111111111111))
    assert!(third.mul_r<Nearest>(third) == wad(111111111111111111))
    // agrees with core where core defines the direction
    assert!(third.mul_r<Down>(third) == third * third)
    assert!(third.mul_r<Up>(third) == third.mul_up(third))
    let two = Wad::from_int(2)
    let three = Wad::from_int(3)
    assert!(two.div_r<Down>(three) == wad(666666666666666666))
    assert!(two.div_r<Nearest>(three) == wad(666666666666666667))
    assert!(two.div_r<Up>(three) == two.div_up(three))
    // half an ulp: 0.5e-18 rounds away from zero
    assert!(wad(500000000000000000).mul_r<Nearest>(wad(1)) == wad(1))
    assert!(wad(499999999999999999).mul_r<Nearest>(wad(1)) == wad(0))
    let r = Ray::from_ratio(2, 3)
    assert!(r.mul_r<Nearest>(Ray::from_int(1)) == r)
}

#[test]
fn signed_fixed_rounding() {
    let a = swad(-1000000000000000000)
    let b = swad(3000000000000000000)
    // -1/3
    assert!(a.div_r<Down>(b) == swad(-333333333333333334))
    assert!(a.div_r<Up>(b) == swad(-333333333333333333))
    assert!(a.div_r<Zero>(b) == swad(-333333333333333333))
    assert!(a.div_r<Zero>(b) == a / b) // core truncates
    assert!(a.div_r<Nearest>(b) == swad(-333333333333333333))
    // -1.5e-18 * 1 -> nearest is -2e-18 (away from zero)
    let half = swad(500000000000000000)
    assert!(swad(-3).mul_r<Nearest>(half) == swad(-2))
    assert!(swad(-3).mul_r<Down>(half) == swad(-2))
    assert!(swad(-3).mul_r<Up>(half) == swad(-1))
    assert!(swad(-3).mul_r<Zero>(half) == swad(-3) * half)
}

#[test]
fn checked_ops_return_none() {
    let big = wad(MAX)
    assert!(big.checked_add(wad(1)).is_none())
    assert!(big.checked_add(wad(0)).unwrap() == big)
    assert!(wad(1).checked_sub(wad(2)).is_none())
    assert!(wad(5).checked_sub(wad(2)).unwrap() == wad(3))
    assert!(big.checked_mul<Down>(Wad::from_int(2)).is_none())
    assert!(Wad::one().checked_div<Down>(Wad::zero()).is_none())
    assert!(big.checked_div<Down>(wad(1)).is_none())
    assert!(Wad::from_int(6).checked_div<Down>(Wad::from_int(3)).unwrap() == Wad::from_int(2))

    let smax = swad(I_MAX)
    let smin = swad(-I_MAX - 1)
    assert!(smax.checked_add(swad(1)).is_none())
    assert!(smin.checked_add(swad(-1)).is_none())
    assert!(smin.checked_sub(swad(1)).is_none())
    assert!(smax.checked_sub(swad(-1)).is_none())
    assert!(smin.checked_add(smax).unwrap() == swad(-1))
    assert!(swad(-5).checked_sub(swad(-7)).unwrap() == swad(2))
    assert!(smax.checked_mul<Down>(SWad::from_int(2)).is_none())
    assert!(SWad::one().checked_div<Up>(SWad::zero()).is_none())
}

#[test]
fn rescale_with_rounding() {
    let w = wad(1234567500000000000)
    let usdc: Option<UFixed<6>> = checked_rescale<Nearest, 18, 6>(w)
    assert!(usdc.unwrap().raw() == 1234568)
    let usdc_down: Option<UFixed<6>> = checked_rescale<Down, 18, 6>(w)
    assert!(usdc_down.unwrap().raw() == 1234567)
    let wide: Option<UFixed<60>> = checked_rescale<Down, 18, 60>(wad(MAX))
    assert!(wide.is_none())
    let s: Option<Fixed<6>> = checked_rescale_signed<Down, 18, 6>(swad(-1234567100000000000))
    assert!(s.unwrap().raw() == -1234568)
    let s2: Option<Fixed<6>> = checked_rescale_signed<Nearest, 18, 6>(swad(-1234567500000000000))
    assert!(s2.unwrap().raw() == -1234568)
}

#[test]
fn generic_over_signedness_and_scale() {
    // One generic helper serves Wad, Ray and SWad.
    assert!(fee_up(Wad::from_int(100), Wad::from_ratio(3, 1000)) == Wad::from_ratio(3, 10))
    assert!(fee_up(Ray::from_raw(1), Ray::from_raw(1)) == Ray::from_raw(1))
    assert!(fee_up(Ray::from_int(2), Ray::from_ratio(1, 3)) == Ray::from_raw(666666666666666666666666666))
    assert!(fee_up(swad(-3), swad(500000000000000000)) == swad(-1))
}

fn fee_up<T: FixedOps>(_ amount: T, _ rate: T) -> T {
    amount.mul_r<Up>(rate)
}

#[test(should_revert)]
fn mul_r_overflow_panics() {
    let _ = wad(MAX).mul_r<Down>(Wad::from_int(2))
}

#[test(should_revert)]
fn div_r_by_zero_panics() {
    let _ = Wad::one().div_r<Nearest>(Wad::zero())
}

#[test(should_revert)]
fn signed_mul_r_overflow_panics() {
    let _ = swad(I_MAX).mul_r<Up>(SWad::from_int(2))
}
